<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.onurcanogul</groupId>
  <artifactId>transactional-outbox-inbox</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>transactional-outbox-inbox</name>
  <description>Transactional outbox and inbox patterns on Spring Boot, PostgreSQL and Kafka</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>event-contracts</module>
    <module>test-support</module>
    <module>naive-dual-write</module>
    <module>outbox-polling</module>
    <module>inbox-consumer</module>
    <module>chaos-tests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.onurcanogul</groupId>
        <artifactId>event-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.onurcanogul</groupId>
        <artifactId>test-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.onurcanogul</groupId>
        <artifactId>outbox-polling</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.onurcanogul</groupId>
        <artifactId>inbox-consumer</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
